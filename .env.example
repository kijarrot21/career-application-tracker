# Environment configuration template.
# Copy to .env.local with `npm run setup` and fill in the values you need.
# NEVER commit .env.local. Only VARIABLE NAMES belong in this file.
# Blank values mean optional unless a comment says otherwise.
# Do not put real API keys, database passwords, OAuth secrets, or payment
# gateway secrets in this template or in any tracked file.

# Database
# Leave DATABASE_URL empty to use embedded local PGlite at PGLITE_DATA_DIR.
# A non-empty value must be a PostgreSQL / Supabase connection URI and
# switches the app to cloud mode (cloud paths are NOT TESTED).
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# Authentication (Better Auth)
# REQUIRED in production builds: at least 16 characters. `npm run setup`
# generates a secure local value. CI uses a throwaway placeholder only.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encryption
# Optional 32-byte hex key for OAuth refresh tokens at rest. When blank,
# a SHA-256 key is derived from BETTER_AUTH_SECRET instead.
ENCRYPTION_KEY=

# Optional email integration (Gmail API and Microsoft Graph)
# Leave blank to disable. OAuth tokens are encrypted at rest.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Hybrid AI engine (server-side keys only; never expose to the browser)
# Ollama is the local provider. OpenAI and Gemini are optional cloud
# providers and require explicit user consent per run.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Local CPU inference is slower than cloud inference. Bounded 1000-180000 ms.
OLLAMA_REQUEST_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_ALLOW_PRIVATE_LOCAL_ENDPOINT=false

# Payments
# disabled (default): checkout and webhook endpoints stay inactive.
# sandbox: enables sandbox-only credentials and verification.
# Live gateway verification is NOT TESTED and requires owner approval.
PAYMENT_MODE=disabled
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com/snap/v1
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com/v2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com/v1
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300

# Hybrid local-cloud sync
# disabled (default): local outbox capture works, cloud push is blocked.
# sandbox: enables opt-in cloud sync (live round-trip NOT TESTED).
SYNC_MODE=disabled
SYNC_RATE_LIMIT_PER_MIN=60
