# Database: leave DATABASE_URL empty to use embedded local PGlite at PGLITE_DATA_DIR.
# Set DATABASE_URL to a PostgreSQL / Supabase connection URI for cloud hosting.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# Authentication (Better Auth). Run `npm run setup` to generate secure secrets in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Encryption key (32-byte hex) for OAuth refresh tokens at rest (Phase 3).
ENCRYPTION_KEY=

# Optional Phase 3 OAuth Email Integration (Gmail API & Microsoft Graph)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Hybrid AI Engine (strictly server-side; never expose API keys to client)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_ALLOW_PRIVATE_LOCAL_ENDPOINT=false

# Payment Gateway Sandbox Configuration (real-money payments disabled until explicit owner approval)
PAYMENT_MODE=disabled
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com/snap/v1
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com/v2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com/v1
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300

# Hybrid Local-Cloud Sync (disabled until explicitly approved)
SYNC_MODE=disabled
SYNC_RATE_LIMIT_PER_MIN=60
